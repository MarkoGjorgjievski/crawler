{
	"name": "my-crawler",
	"version": "0.0.1",
	"type": "module",
	"description": "This is an example of a Crawlee project.",
	"dependencies": {
		"crawlee": "^3.0.0",
		"playwright": "*"
	},
	"devDependencies": {
		"@apify/tsconfig": "^0.1.0",
		"@biomejs/biome": "2.3.8",
		"@types/node": "^24.0.0",
		"commander": "^14.0.2",
		"tsx": "^4.4.0",
		"typescript": "~5.9.0"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "tsx src/main.ts",
		"build": "tsc",
		"test": "echo \"Error: oops, the actor has no tests yet, sad!\" && exit 1",
		"postinstall": "npx crawlee install-playwright-browsers",
		"scrape:neptun": "tsx src/main.ts --store neptun",
		"scrape:setec": "tsx src/main.ts --store setec",
		"scrape:tehnomarket": "tsx src/main.ts --store tehnomarket",
		"scrape:anhoch": "tsx src/main.ts --store anhoch",
		"scrape:all": "tsx src/main.ts --all",
		"dev": "tsx watch src/main.ts",
		"check": "biome check",
		"format": "biome format --write"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
